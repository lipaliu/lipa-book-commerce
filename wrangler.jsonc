{
  "name": "lipa-book-commerce",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lipa-book-commerce-db",
      "database_id": "87d17fba-922a-41c6-a632-61e552f83217"
    }
  ],
  "triggers": {
    "crons": [
      "0 1 * * *"
    ]
  },
  "ai": { "binding": "AI" },
  "vars": {
    "APP_NAME": "图书带货工作台",
    "DATA_PROVIDER": "huitun_import",
    "LOOKBACK_DAYS": "30"
  }
}
